@model MySchoolApp.Models.Department

<h2>Add New Department</h2>

<form asp-action="Add" method="post" style="max-width:400px">
    @Html.AntiForgeryToken()

    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="MgrName" class="form-label"></label>
        <input asp-for="MgrName" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="ShowAll" class="btn btn-secondary">Cancel</a>
</form>