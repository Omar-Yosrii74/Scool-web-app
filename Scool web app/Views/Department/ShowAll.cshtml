@model IEnumerable<MySchoolApp.Models.Department>

<h2>All Departments</h2>

<a asp-action="Add" class="btn btn-success mb-3">+ Add Department</a>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Manager</th>
            <th>Students</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var dept in Model)
        {
            <tr>
                <td>@dept.Id</td>
                <td>@dept.Name</td>
                <td>@dept.MgrName</td>
                <td>@dept.Students?.Count</td>
                <td>
                    <a asp-action="ShowDetails" asp-route-id="@dept.Id"
                       class="btn btn-info btn-sm">Details</a>
                    <a asp-action="DeptStats" asp-route-id="@dept.Id"
                       class="btn btn-warning btn-sm">Stats</a>
                </td>
            </tr>
        }
    </tbody>
</table>